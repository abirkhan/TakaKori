# Supabase — development project
# Get these from: Supabase Dashboard > your project > Connect
# The publishable key is safe to expose to the browser. The secret key is NOT.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE

# Never commit real secrets. Server-only, no NEXT_PUBLIC_ prefix.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_KEY_HERE